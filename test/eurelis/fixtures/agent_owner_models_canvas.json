      {"id": "Message:Final", "type": "messageNode", "position": {"x": 600, "y": 0}, "data": {"label": "Message", "name": "Réponse"}}
    ],
    "edges": [
      {"id": "e1", "source": "begin", "target": "LLM:Answer", "sourceHandle": "start", "targetHandle": "end"},
