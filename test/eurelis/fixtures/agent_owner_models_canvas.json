{
  "components": {
    "begin": {
      "obj": {
        "component_name": "Begin",
        "params": {
          "enablePrologue": false,
          "mode": "conversational",
          "layout_recognize": "",
          "prologue": "",
          "inputs": {
            "question": {"key": "question", "name": "question", "optional": false, "options": [], "type": "line", "value": ""},
            "document": {"key": "document", "name": "document", "optional": false, "options": [], "type": "file", "value": ""}
          },
          "outputs": {}
        }
      },
      "downstream": ["LLM:Answer"],
      "upstream": []
    },
    "LLM:Answer": {
      "obj": {
        "component_name": "LLM",
        "params": {
          "llm_id": "__CHAT_MODEL__",
          "sys_prompt": "Tu réponds en une phrase courte, en français.",
          "prompts": [{"role": "user", "content": "Document :\n{begin@document}\n\nQuestion : {begin@question}"}],
          "temperature": 0,
          "cite": false,
          "outputs": {"content": {"type": "string", "value": ""}}
        }
      },
      "downstream": ["Message:Final"],
      "upstream": ["begin"]
    },
    "Message:Final": {
      "obj": {
        "component_name": "Message",
        "params": {
          "content": ["FICHIER : {begin@document}\n\nREPONSE : {LLM:Answer@content}"],
          "output_format": "markdown"
        }
      },
      "downstream": [],
      "upstream": ["LLM:Answer"]
    }
  },
